<?xml version="1.0"?>
<robot name="point_robot">

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.083333"
        ixy="0.0"
        ixz="0.0"
        iyy="0.166667"
        iyz="0.0"
        izz="0.216667"/>
    </inertial>
  </link>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.12 0.08 0.08"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.12 0.08 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.000213"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000347"
        iyz="0.0"
        izz="0.000347"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0 0.28" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit
      lower="-1.5708"
      upper="1.5708"
      effort="1.0"
      velocity="1.0"/>
  </joint>

</robot>
