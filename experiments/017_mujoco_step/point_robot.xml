<mujoco model="point_robot">
  <!-- One simulation step advances physical time by 0.01 seconds. -->
  <option timestep="0.01" gravity="0 0 0" integrator="RK4"/>

  <worldbody>
    <!-- The floor is visual context; zero gravity keeps this lesson one-dimensional. -->
    <geom
      name="floor"
      type="plane"
      size="3 1 0.1"
      rgba="0.85 0.85 0.85 1"
    />

    <body name="point_robot" pos="0 0 0.06">
      <!-- A slide joint permits translation only along the world x-axis. -->
      <joint
        name="x_slide"
        type="slide"
        axis="1 0 0"
        range="-5 5"
        damping="0.4"
      />
      <geom
        name="robot_body"
        type="sphere"
        size="0.06"
        mass="1.0"
        rgba="0.1 0.35 0.85 1"
      />
    </body>
  </worldbody>

  <actuator>
    <!-- ctrl[0] drives this motor; it is a force-like input, not a target position. -->
    <motor
      name="x_motor"
      joint="x_slide"
      ctrllimited="true"
      ctrlrange="-1 1"
    />
  </actuator>
</mujoco>
